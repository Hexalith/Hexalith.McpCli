<?xml version='1.0' encoding='utf-8'?>
<Project><PropertyGroup><WarningsNotAsErrors /></PropertyGroup><ItemGroup><PackageVersion Include="Google.Protobuf" Exclude="@(PackageVersion)" Version="3.36.2" /><PackageVersion Update="Google.Protobuf" Version="3.36.2" /><PackageVersion Include="Grpc.Core.Api" Exclude="@(PackageVersion)" Version="2.85.0" /><PackageVersion Update="Grpc.Core.Api" Version="2.85.0" /><PackageVersion Include="Grpc.Net.Client" Exclude="@(PackageVersion)" Version="2.85.0" /><PackageVersion Update="Grpc.Net.Client" Version="2.85.0" /><PackageVersion Include="Grpc.Net.Common" Exclude="@(PackageVersion)" Version="2.85.0" /><PackageVersion Update="Grpc.Net.Common" Version="2.85.0" /><PackageVersion Include="Grpc.Reflection" Exclude="@(PackageVersion)" Version="2.85.0" /><PackageVersion Update="Grpc.Reflection" Version="2.85.0" /><PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Exclude="@(PackageVersion)" Version="11.0.0" /><PackageVersion Update="Microsoft.Extensions.AI.Abstractions" Version="11.0.0" /><PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Exclude="@(PackageVersion)" Version="11.0.0" /><PackageVersion Update="Microsoft.Extensions.Caching.Abstractions" Version="11.0.0" /><PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Exclude="@(PackageVersion)" Version="5.12.0" /><PackageVersion Update="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" /><PackageVersion Include="Microsoft.CodeAnalysis.Common" Exclude="@(PackageVersion)" Version="5.12.0" /><PackageVersion Update="Microsoft.CodeAnalysis.Common" Version="5.12.0" /><PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Exclude="@(PackageVersion)" Version="5.12.0" /><PackageVersion Update="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" /><PackageVersion Include="StackExchange.Redis" Exclude="@(PackageVersion)" Version="3.4.35" /><PackageVersion Update="StackExchange.Redis" Version="3.4.35" /></ItemGroup><ItemGroup><PackageVersion Update="Hexalith.McpCli.Abstractions" Version="2.0.1" /></ItemGroup><PropertyGroup Condition="'$(MSBuildProjectName)' == 'Hexalith.Tenants'"><DisableMicrosoftExtensionsLoggingSourceGenerator>false</DisableMicrosoftExtensionsLoggingSourceGenerator></PropertyGroup><Target Name="McpCliRequireDeterministicLoggingGenerator" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'Hexalith.Tenants'"><ItemGroup><_McpCliTelemetryLoggingGenerator Include="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'Microsoft.Gen.Logging'" /></ItemGroup><Error Condition="'@(_McpCliTelemetryLoggingGenerator-&gt;Count())' != '1'" Text="The current Tenant fixture requires exactly one Microsoft.Gen.Logging generator." /><ItemGroup><_McpCliTelemetryLoggingGeneratorExpected Include="@(_McpCliTelemetryLoggingGenerator)" Condition="'%(_McpCliTelemetryLoggingGenerator.NuGetPackageId)' == 'Microsoft.Extensions.Telemetry.Abstractions' And '%(_McpCliTelemetryLoggingGenerator.NuGetPackageVersion)' == '11.0.0'" /></ItemGroup><Error Condition="'@(_McpCliTelemetryLoggingGeneratorExpected-&gt;Count())' != '1'" Text="The current Tenant fixture requires the exact Microsoft.Extensions.Telemetry.Abstractions 11.0.0 generator identity." /><ItemGroup><_McpCliStandardLoggingGenerator Include="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'Microsoft.Extensions.Logging.Generators'" /></ItemGroup><Error Condition="'@(_McpCliStandardLoggingGenerator-&gt;Count())' != '1'" Text="The current Tenant fixture requires exactly one Microsoft.Extensions.Logging.Generators generator." /><ItemGroup><_McpCliStandardLoggingGeneratorExpected Include="@(_McpCliStandardLoggingGenerator)" Condition="'%(_McpCliStandardLoggingGenerator.NuGetPackageId)' == 'Microsoft.NETCore.App.Ref' And '%(_McpCliStandardLoggingGenerator.NuGetPackageVersion)' == '11.0.0' And '%(_McpCliStandardLoggingGenerator.FrameworkReferenceName)' == 'Microsoft.NETCore.App' And '%(_McpCliStandardLoggingGenerator.FrameworkReferenceVersion)' == '11.0.0'" /></ItemGroup><Error Condition="'@(_McpCliStandardLoggingGeneratorExpected-&gt;Count())' != '1'" Text="The current Tenant fixture requires the exact Microsoft.NETCore.App.Ref 11.0.0 generator identity." /><ItemGroup><Analyzer Remove="@(_McpCliTelemetryLoggingGenerator)" /></ItemGroup></Target></Project>