<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <HexalithBuildPackageVersions1>$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/Directory.Packages.props</HexalithBuildPackageVersions1>
    <HexalithBuildPackageVersions2>$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/Directory.Packages.props</HexalithBuildPackageVersions2>
    <HexalithBuildPackageVersions3>$(MSBuildThisFileDirectory)../../Hexalith.Builds/Props/Directory.Packages.props</HexalithBuildPackageVersions3>
  </PropertyGroup>
  <Import Project="$(HexalithBuildPackageVersions1)" Condition="Exists('$(HexalithBuildPackageVersions1)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(HexalithBuildPackageVersions2)" Condition="Exists('$(HexalithBuildPackageVersions2)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(HexalithBuildPackageVersions3)" Condition="Exists('$(HexalithBuildPackageVersions3)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <ItemGroup>
    <!-- Select Aspire 17 until Hexalith.Builds catalogs that line. -->
    <PackageVersion Update="Aspire.Azure.Messaging.ServiceBus" Version="17.0.0" />
    <PackageVersion Update="Aspire.Azure.Security.KeyVault" Version="17.0.0" />
    <PackageVersion Update="Aspire.Azure.Storage.Blobs" Version="17.0.0" />
    <PackageVersion Update="Aspire.Azure.Storage.Queues" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Azure.AppContainers" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Azure.CosmosDB" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Docker" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Keycloak" Version="17.0.0-preview.1.26567.5" />
    <PackageVersion Update="Aspire.Hosting.Kubernetes" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Redis" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Testing" Version="17.0.0" />
    <PackageVersion Update="Aspire.Microsoft.Azure.Cosmos" Version="17.0.0" />
    <PackageVersion Update="CommunityToolkit.Aspire.Hosting.Dapr" Version="17.0.0-beta.1078" />
  </ItemGroup>
</Project>
