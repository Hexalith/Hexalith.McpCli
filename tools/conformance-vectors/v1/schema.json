{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.dev/mcpcli/conformance-vectors/v1/schema.json",
  "title": "McpCli conformance vector v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "package", "operation", "kind", "prerequisites", "invocation", "postconditions"],
  "properties": {
    "formatVersion": { "const": 1 },
    "package": { "$ref": "#/$defs/package" },
    "operation": { "$ref": "#/$defs/operation" },
    "kind": { "$ref": "#/$defs/kind" },
    "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "invocation": { "$ref": "#/$defs/step" },
    "postconditions": { "type": "array", "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[0-9A-Za-z.-]+)?$" }
      }
    },
    "operation": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$" },
    "kind": { "enum": ["command", "query"] },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant"],
      "properties": {
        "tenant": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "aggregateId": { "type": "string", "minLength": 1 },
        "entityId": { "type": "string", "minLength": 1 },
        "correlationId": { "$ref": "#/$defs/ulid" },
        "idempotencyKey": { "$ref": "#/$defs/ulid" },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
        "offset": { "type": "integer", "minimum": 0 },
        "cursor": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "extensions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "ulid": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "body", "maskGenerated"],
      "properties": {
        "method": { "const": "POST" },
        "path": { "enum": ["/api/v1/commands", "/api/v1/queries"] },
        "body": { "type": "object" },
        "maskGenerated": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["/messageId", "/correlationId"] }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusCode", "body", "echoRequestFields"],
      "properties": {
        "statusCode": { "type": "integer", "minimum": 200, "maximum": 599 },
        "body": { "type": "object" },
        "echoRequestFields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["correlationId", "messageId"] }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$" },
        "operator": { "enum": ["equals", "exists", "arrayLength", "contains"] },
        "value": {}
      },
      "allOf": [
        { "if": { "properties": { "operator": { "const": "exists" } } }, "then": { "required": ["value"], "properties": { "value": { "type": "boolean" } } } },
        { "if": { "properties": { "operator": { "const": "arrayLength" } } }, "then": { "required": ["value"], "properties": { "value": { "type": "integer", "minimum": 0 } } } },
        { "if": { "properties": { "operator": { "enum": ["equals", "contains"] } } }, "then": { "required": ["value"] } }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "kind", "payload", "envelope", "expectedGateway", "scriptedResponse", "assertions"],
      "properties": {
        "operation": { "$ref": "#/$defs/operation" },
        "kind": { "$ref": "#/$defs/kind" },
        "payload": { "type": "object" },
        "envelope": { "$ref": "#/$defs/envelope" },
        "expectedGateway": { "$ref": "#/$defs/gateway" },
        "scriptedResponse": { "$ref": "#/$defs/response" },
        "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } }
      }
    }
  }
}
