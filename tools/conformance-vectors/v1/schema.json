{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexalith.dev/mcpcli/conformance-vectors/v1/schema.json",
  "title": "McpCli conformance vector v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "package", "operation", "kind", "prerequisites", "invocation", "postconditions"],
  "properties": {
    "formatVersion": { "type": "integer", "const": 1 },
    "package": { "$ref": "#/$defs/package" },
    "operation": { "$ref": "#/$defs/operation" },
    "kind": { "$ref": "#/$defs/kind" },
    "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "invocation": { "$ref": "#/$defs/step" },
    "postconditions": { "type": "array", "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*(?![\\s\\S])" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[0-9A-Za-z.-]+)?(?![\\s\\S])" }
      }
    },
    "operation": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])" },
    "kind": { "enum": ["command", "query"] },
    "nonblank": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$(?![\\s\\S])"
    },
    "extensions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "paging": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "cursor": { "$ref": "#/$defs/nonblank", "maxLength": 4096 }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant"],
      "properties": {
        "tenant": { "$ref": "#/$defs/tenant" },
        "actor": { "$ref": "#/$defs/nonblank" },
        "aggregateId": { "$ref": "#/$defs/nonblank" },
        "entityId": { "$ref": "#/$defs/nonblank" },
        "correlationId": { "$ref": "#/$defs/ulid" },
        "idempotencyKey": { "$ref": "#/$defs/ulid" },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "cursor": { "$ref": "#/$defs/nonblank", "maxLength": 4096 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "ulid": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}(?![\\s\\S])" },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "body", "maskGenerated"],
      "properties": {
        "method": { "const": "POST" },
        "path": { "enum": ["/api/v1/commands", "/api/v1/queries"] },
        "body": { "type": "object" },
        "maskGenerated": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["/messageId", "/correlationId"] }
        }
      }
    },
    "commandGatewayBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "tenant", "domain", "aggregateId", "commandType", "payload", "correlationId"],
      "properties": {
        "messageId": { "const": "<generated>" },
        "tenant": { "$ref": "#/$defs/tenant" },
        "domain": { "$ref": "#/$defs/tenant" },
        "aggregateId": { "$ref": "#/$defs/nonblank" },
        "commandType": { "$ref": "#/$defs/nonblank" },
        "payload": { "type": "object" },
        "correlationId": {
          "anyOf": [
            { "$ref": "#/$defs/ulid" },
            { "const": "<generated>" }
          ]
        },
        "extensions": { "$ref": "#/$defs/extensions" },
        "idempotencyKey": { "$ref": "#/$defs/ulid" }
      }
    },
    "queryGatewayBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "domain", "aggregateId", "queryType", "projectionType"],
      "properties": {
        "tenant": { "$ref": "#/$defs/tenant" },
        "domain": { "$ref": "#/$defs/tenant" },
        "aggregateId": { "$ref": "#/$defs/nonblank" },
        "queryType": { "$ref": "#/$defs/nonblank" },
        "projectionType": { "$ref": "#/$defs/tenant" },
        "payload": {},
        "entityId": { "$ref": "#/$defs/nonblank" },
        "projectionActorType": { "$ref": "#/$defs/nonblank", "maxLength": 64 },
        "paging": { "$ref": "#/$defs/paging" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusCode", "body", "echoRequestFields"],
      "properties": {
        "statusCode": { "type": "integer", "minimum": 200, "maximum": 599 },
        "body": { "type": "object" },
        "echoRequestFields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["correlationId", "messageId"] }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)*(?![\\s\\S])" },
        "operator": { "enum": ["equals", "exists", "arrayLength", "contains"] },
        "value": {}
      },
      "allOf": [
        { "if": { "properties": { "operator": { "const": "exists" } } }, "then": { "required": ["value"], "properties": { "value": { "type": "boolean" } } } },
        { "if": { "properties": { "operator": { "const": "arrayLength" } } }, "then": { "required": ["value"], "properties": { "value": { "type": "integer", "minimum": 0 } } } },
        { "if": { "properties": { "operator": { "enum": ["equals", "contains"] } } }, "then": { "required": ["value"] } }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "kind", "payload", "envelope", "expectedGateway", "scriptedResponse", "assertions"],
      "properties": {
        "operation": { "$ref": "#/$defs/operation" },
        "kind": { "$ref": "#/$defs/kind" },
        "payload": {},
        "envelope": { "$ref": "#/$defs/envelope" },
        "expectedGateway": { "$ref": "#/$defs/gateway" },
        "scriptedResponse": { "$ref": "#/$defs/response" },
        "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "command" } } },
          "then": {
            "properties": {
              "payload": { "type": "object" },
              "expectedGateway": {
                "properties": { "body": { "$ref": "#/$defs/commandGatewayBody" } }
              }
            }
          },
          "else": {
            "properties": {
              "expectedGateway": {
                "properties": { "body": { "$ref": "#/$defs/queryGatewayBody" } }
              }
            }
          }
        }
      ]
    }
  }
}
