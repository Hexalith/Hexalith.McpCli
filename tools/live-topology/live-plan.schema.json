{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "vectorSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deadlineSeconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 120
    },
    "pollSeconds": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 5
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "step": {
                "type": "string",
                "pattern": "^/(invocation|prerequisites/[0-9]+|postconditions/[0-9]+)$"
              },
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "enum": [
                        "/envelope/cursor",
                        "/payload/From",
                        "/payload/To"
                      ]
                    },
                    "capture": {
                      "type": "string",
                      "minLength": 1
                    },
                    "offsetSeconds": {
                      "type": "number",
                      "minimum": -3600,
                      "maximum": 3600
                    }
                  },
                  "required": [
                    "path",
                    "capture"
                  ],
                  "additionalProperties": false
                }
              },
              "captures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^/.*"
                    },
                    "type": {
                      "enum": [
                        "string",
                        "timestamp"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "path",
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "assertionBindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "capture": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "index",
                    "capture"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "step"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "query": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "query"
                  },
                  "payload": {
                    "type": "object"
                  },
                  "envelope": {
                    "type": "object",
                    "properties": {
                      "tenant": {
                        "type": "string",
                        "minLength": 1
                      },
                      "actor": {
                        "type": "string",
                        "minLength": 1
                      },
                      "aggregateId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "entityId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pageSize": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      "offset": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2147483647
                      },
                      "cursor": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "tenant"
                    ],
                    "additionalProperties": false
                  },
                  "assertions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "pattern": "^(|/.*)$"
                        },
                        "operator": {
                          "enum": [
                            "equals",
                            "contains",
                            "arrayLength",
                            "exists"
                          ]
                        },
                        "value": {}
                      },
                      "required": [
                        "path",
                        "operator",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "operation",
                  "kind",
                  "payload",
                  "envelope",
                  "assertions"
                ],
                "additionalProperties": false
              },
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "enum": [
                        "/envelope/cursor",
                        "/payload/From",
                        "/payload/To"
                      ]
                    },
                    "capture": {
                      "type": "string",
                      "minLength": 1
                    },
                    "offsetSeconds": {
                      "type": "number",
                      "minimum": -3600,
                      "maximum": 3600
                    }
                  },
                  "required": [
                    "path",
                    "capture"
                  ],
                  "additionalProperties": false
                }
              },
              "captures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^/.*"
                    },
                    "type": {
                      "enum": [
                        "string",
                        "timestamp"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "path",
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "assertionBindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "capture": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "index",
                    "capture"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "label",
              "query"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "operation",
    "vectorSha256",
    "deadlineSeconds",
    "pollSeconds",
    "actions"
  ],
  "additionalProperties": false
}
