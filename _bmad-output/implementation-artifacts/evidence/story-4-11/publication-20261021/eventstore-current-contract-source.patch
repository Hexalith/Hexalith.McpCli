+                sequence += take;
+            }
+            else
+            {
+                int take = (int)Math.Min(page.Count, retained - sequence + 1);
+                if (!page.Digests.AsSpan(0, take * 32).SequenceEqual(existing.CapturedEventDigests!.AsSpan(checked((int)(sequence - 1) * 32), take * 32))) return false;
+                sequence += take;
+            }
+        }
+        return true;
+    }
