diff --git a/tests/Hexalith.EventStore.Server.LiveSidecar.Tests/Integration/NamedProjectionRetryFixtureTests.cs b/tests/Hexalith.EventStore.Server.LiveSidecar.Tests/Integration/NamedProjectionRetryFixtureTests.cs
