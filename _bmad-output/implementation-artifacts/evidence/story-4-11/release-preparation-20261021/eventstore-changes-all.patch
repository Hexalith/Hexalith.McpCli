+            Match source = Regex.Match(alias, @"\A@\((?<name>[A-Za-z_][A-Za-z0-9_.-]*)(?:\s*->\s*WithMetadataValue\(\s*'[^']*'\s*,\s*'[^']*'\s*\))?\s*\)\z",
+                RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
