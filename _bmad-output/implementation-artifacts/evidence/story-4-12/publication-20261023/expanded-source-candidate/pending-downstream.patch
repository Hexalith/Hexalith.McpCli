+        {
+            ["Topology"] = new("Topology", "", "project", new Dictionary<string, string> { [Helper] = "1.0.0" }, []),
+            [Helper] = new(Helper, "1.0.0", "package", new Dictionary<string, string>(), []),
+        };
+        return (policy, new("Topology", nodes, []));
+    }
+}
