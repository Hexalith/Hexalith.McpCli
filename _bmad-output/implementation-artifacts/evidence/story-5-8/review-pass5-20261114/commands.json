      "name": "untracked-whitespace",
      "command": [
        "python3",
        "-B",
        "-I",
        "-c",
        "import subprocess\nprefix = ['git', '-c', 'core.commitGraph=false']\npaths = subprocess.run(prefix+['ls-files', '--others', '--exclude-standard', '-z'], check=True, capture_output=True).stdout.split(b'\\0')\nfor path in paths:\n    if path:\n        result = subprocess.run(prefix+['diff', '--no-index', '--check', '--', '/dev/null', path.decode()], capture_output=True)\n        if result.returncode not in {0, 1} or result.stdout or result.stderr:\n            raise SystemExit('untracked whitespace check failed: '+path.decode())\n"
      ],
