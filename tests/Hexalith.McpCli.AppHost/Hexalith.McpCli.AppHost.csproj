<Project Sdk="Aspire.AppHost.Sdk/17.0.0">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <!-- Keep AddProject and the AppHost SDK while EventStore/Tenants/Parties/Projects helpers still return ProjectResource. -->
    <SuppressAspireAppHostSdkObsoleteWarning>true</SuppressAspireAppHostSdkObsoleteWarning>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hexalith.EventStore.Aspire" />
    <PackageReference Include="Hexalith.Tenants.Aspire" />
    <PackageReference Include="Hexalith.Parties.Aspire" />
    <Content Include="DaprComponents/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
