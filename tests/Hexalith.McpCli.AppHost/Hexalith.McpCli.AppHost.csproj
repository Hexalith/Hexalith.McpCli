<Project Sdk="Aspire.AppHost.Sdk/13.6.5">
  <!-- Only the current native fixture selects framework 11; product TFMs remain net10.0. -->
  <PropertyGroup Condition="'$(McpCliCurrentNativeProfile)' == 'true'">
    <RuntimeFrameworkVersion>11.0.0</RuntimeFrameworkVersion>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hexalith.EventStore.Aspire" />
    <PackageReference Include="Hexalith.Tenants.Aspire" />
    <PackageReference Include="Hexalith.Parties.Aspire" />
    <Content Include="DaprComponents/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
