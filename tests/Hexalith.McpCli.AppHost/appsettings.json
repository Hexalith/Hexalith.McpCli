{
  "Dapr": { "GatewayHttpPort": 3501 },
  "Tenants": { "BootstrapGlobalAdminEnabled": true, "BootstrapGlobalAdminUserId": "mcpcli-live-admin" },
  "Gateway": {
    "TopicOverrides": { "global-administrators": "tenants.events" },
    "Routes": {
      "system|tenants|v1": { "TenantId": "system", "Domain": "tenants", "Version": "v1", "AppId": "tenants", "MethodName": "process" },
      "system|global-administrators|v1": { "TenantId": "system", "Domain": "global-administrators", "Version": "v1", "AppId": "tenants", "MethodName": "process" },
      "*|party|v1": { "TenantId": "*", "Domain": "party", "Version": "v1", "AppId": "parties", "MethodName": "process" }
    }
  }
}
