<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RequireContractsFlag>true</RequireContractsFlag>
    <ConformanceProduction Condition="'$(ConformanceProduction)' == ''">true</ConformanceProduction>
    <DefineConstants Condition="'$(ConformanceProduction)' == 'true'">$(DefineConstants);CONFORMANCE_PRODUCTION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Hexalith.McpCli.Core.Tests/InventoryCoverage*.cs" Exclude="../Hexalith.McpCli.Core.Tests/InventoryCoverageTests.cs;../Hexalith.McpCli.Core.Tests/InventoryCoverageContractsAssembly.cs" Link="Inventory/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/Hexalith.McpCli/Hexalith.McpCli.csproj" />
    <PackageReference Include="Hexalith.McpCli.Sample.Contracts" HexalithContracts="true" Condition="'$(ConformanceProduction)' != 'true'" />
  </ItemGroup>
  <Import Project="../../src/Hexalith.McpCli/Build/ModuleAssemblyManifest.targets" />
</Project>
