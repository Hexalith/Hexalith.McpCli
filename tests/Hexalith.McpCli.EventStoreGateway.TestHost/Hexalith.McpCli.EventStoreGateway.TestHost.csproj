<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <McpCliEventStoreRoot Condition="'$(McpCliEventStoreRoot)' == ''">$(MSBuildThisFileDirectory)../../references/Hexalith.EventStore</McpCliEventStoreRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hexalith.EventStore.Gateway" />
    <Content Include="$(McpCliEventStoreRoot)/src/Hexalith.EventStore/appsettings.json"
             Link="appsettings.gateway.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
