<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hexalith.EventStore.Gateway" />
    <!-- Reviewed nonsecret native defaults remain available in Builds-only jobs. -->
    <Content Remove="Configuration/appsettings.gateway.json" />
    <Content Include="Configuration/appsettings.gateway.json" TargetPath="appsettings.gateway.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Update="Configuration/provenance.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
