<Project>
  <PropertyGroup>
    <!-- Pin the gateway client and enrolled Contracts before the Builds catalog import; enrolled Contracts stay on the exact artifacts bound by the approved vectors. -->
    <HexalithEventStoreVersion Condition="'$(HexalithEventStoreVersion)' == ''">4.2.0</HexalithEventStoreVersion>
    <HexalithMcpCliVersion Condition="'$(HexalithMcpCliVersion)' == ''">2.0.1</HexalithMcpCliVersion>
    <HexalithPartiesVersion Condition="'$(HexalithPartiesVersion)' == ''">3.1.1</HexalithPartiesVersion>
    <HexalithPartiesAspireVersion Condition="'$(HexalithPartiesAspireVersion)' == ''">3.1.1</HexalithPartiesAspireVersion>
    <HexalithTenantsVersion Condition="'$(HexalithTenantsVersion)' == ''">7.0.7</HexalithTenantsVersion>
    <HexalithBuildPackageVersions1>$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/Directory.Packages.props</HexalithBuildPackageVersions1>
    <HexalithBuildPackageVersions2>$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/Directory.Packages.props</HexalithBuildPackageVersions2>
    <HexalithBuildPackageVersions3>$(MSBuildThisFileDirectory)../../Hexalith.Builds/Props/Directory.Packages.props</HexalithBuildPackageVersions3>
  </PropertyGroup>
  <Import Project="$(HexalithBuildPackageVersions1)" Condition="Exists('$(HexalithBuildPackageVersions1)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(HexalithBuildPackageVersions2)" Condition="Exists('$(HexalithBuildPackageVersions2)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(HexalithBuildPackageVersions3)" Condition="Exists('$(HexalithBuildPackageVersions3)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <ItemGroup>
    <!-- Preserve the product's .NET 10 target when the shared catalog advances to .NET 11-only packages. -->
    <PackageVersion Update="Hexalith.Commons.UniqueIds" Version="2.30.10" />
    <PackageVersion Update="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Update="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Update="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.15" />
    <!-- OpenApi 10 requires the compatible 2.x document model rather than the catalog's 3.x selection. -->
    <PackageVersion Update="Microsoft.OpenApi" Version="2.13.0" />
    <!-- The isolated suite owns its AppHost lifecycle through Aspire; all SDK packages use the current cohort. -->
    <PackageVersion Update="Hexalith.EventStore.Testing.Integration" Version="4.2.0" />
    <!-- Keep the EventStore 4.2.0 Redis floor explicit across Builds catalog revisions. -->
    <PackageVersion Update="StackExchange.Redis" Version="3.4.31" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <Version Condition="'$(Version)' == ''">2.0.1</Version>
    <Authors>Hexalith Contributors</Authors>
    <Company>Hexalith</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.McpCli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.McpCli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
