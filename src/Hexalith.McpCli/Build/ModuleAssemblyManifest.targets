<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <UsingTask TaskName="GenerateModuleAssemblyManifest" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Packages ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <References ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Reflection" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var matches = new System.Collections.Generic.List<(string PackageId, string AssemblyName)>();
        var failed = false;
        foreach (var package in Packages.Where(p => string.Equals(p.GetMetadata("HexalithContracts"), "true", StringComparison.OrdinalIgnoreCase)))
        {
            var packageId = package.ItemSpec;
            var assets = References
                .Where(r => string.Equals(r.GetMetadata("NuGetPackageId"), packageId, StringComparison.OrdinalIgnoreCase)
                    && Path.GetFileName(r.ItemSpec).EndsWith(".Contracts.dll", StringComparison.Ordinal))
                .ToArray();
            if (assets.Length != 1)
            {
                Log.LogError($"HexalithContracts package '{packageId}' has {assets.Length} matching *.Contracts.dll copy-local assets; expected exactly one.");
                failed = true;
                continue;
            }

            var fileName = Path.GetFileNameWithoutExtension(assets[0].ItemSpec);
            var assemblyName = AssemblyName.GetAssemblyName(assets[0].ItemSpec).Name;
            if (!string.Equals(assemblyName, fileName, StringComparison.Ordinal))
            {
                Log.LogError($"HexalithContracts package '{packageId}' asset '{Path.GetFileName(assets[0].ItemSpec)}' has assembly identity '{assemblyName}'; expected '{fileName}'.");
                failed = true;
                continue;
            }

            matches.Add((packageId, assemblyName));
        }

        if (failed)
        {
            if (File.Exists(OutputPath))
            {
                File.Delete(OutputPath);
            }

            return false;
        }

        matches.Sort((x, y) => StringComparer.Ordinal.Compare(x.AssemblyName, y.AssemblyName));
        string Quote(string value) => "\"" + value.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
        var content = new StringBuilder();
        content.Append("// <auto-generated />\nnamespace Hexalith.McpCli.Hosting;\n\ninternal static class ModuleAssemblyManifest\n{\n    internal static readonly (string PackageId, string AssemblyName)[] Entries =\n    {\n");
        foreach (var match in matches)
        {
            content.Append("        (").Append(Quote(match.PackageId)).Append(", ").Append(Quote(match.AssemblyName)).Append("),\n");
        }

        content.Append("    };\n}\n");
        var generated = content.ToString().Replace("\n", "\r\n");
        if (!File.Exists(OutputPath) || !string.Equals(File.ReadAllText(OutputPath), generated, StringComparison.Ordinal))
        {
            Directory.CreateDirectory(Path.GetDirectoryName(OutputPath));
            File.WriteAllText(OutputPath, generated, new UTF8Encoding(false));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateModuleAssemblyManifest" AfterTargets="ResolveReferences" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <GenerateModuleAssemblyManifest Packages="@(PackageReference)" References="@(ReferenceCopyLocalPaths)" OutputPath="$(IntermediateOutputPath)ModuleAssemblyManifest.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ModuleAssemblyManifest.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)ModuleAssemblyManifest.g.cs" />
    </ItemGroup>
  </Target>
</Project>
